# Режим работы приложения
APP_ENV=local
DEBUG=false

# База данных (для локального запуска по умолчанию SQLite, для Docker/PostgreSQL раскомментируйте)
DATABASE_URL=sqlite+aiosqlite:///./nedra.db
DATABASE_URL_SYNC=sqlite:///./nedra.db
# DATABASE_URL=postgresql+asyncpg://nedra:nedra_secure_password@localhost:5432/nedra
# DATABASE_URL_SYNC=postgresql+psycopg2://nedra:nedra_secure_password@localhost:5432/nedra

# Очередь фоновых задач (Redis)
REDIS_URL=redis://localhost:6379/0
REDIS_QUEUE_NAME=nedra_import_queue
USE_REDIS_QUEUE=false

# Объектное хранилище (MinIO / S3)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=nedra-excel-files
MINIO_SECURE=false
USE_S3_STORAGE=false
LOCAL_STORAGE_DIR=./storage/uploads
